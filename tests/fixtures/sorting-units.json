        {
            "id": "media-cascade",
            "input": ".a { color:red; @media (min-width:1px) { color:blue; } color:green; }"
        },
        {
            "id": "comments-and-nested-rule",
            "input": ".a { width:1px; /* block */ .b { color:red; } height:2px; // tail\n }"
        },
        {
            "id": "conditional-chain",
            "input": ".a { color:red; @if $ok { color:blue; } @else { color:green; } color:black; }"
        },
        {
            "id": "nested-properties",
            "input": ".a { font-size:1px; font: { size:2px; weight:700; } color:red; }"
        },
        {
            "id": "prettier-ignore",
            "input": ".a { width:1px; /* prettier-ignore */ .b {color:red;color:blue} color:green; }"
        }
